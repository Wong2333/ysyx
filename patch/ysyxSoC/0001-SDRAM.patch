 class sdramChisel extends RawModule {
   val io = IO(Flipped(new SDRAMIO))
+  val dq_out_en = WireDefault(false.B)
+  val dq_out = Wire(UInt(32.W))
+  dq_out := DontCare
+  val dq_in = TriStateInBuf(io.dq, dq_out, dq_out_en)
+  
+  withClock(io.clk.asClock){
+    when(io.cke){
+    val cmd = Cat(io.cs, io.ras, io.cas, io.we)
+    val mode_reg = Reg(UInt(13.W))
+
+    val rows = Reg(Vec(4,UInt(13.W)))
+    val addr_reg = Reg(UInt(24.W))
+
+    val cas_latency = mode_reg(6,4)
+    val burst_length = MuxLookup(mode_reg(2,0), 1.U)(Seq(
+      "b0000".U -> 1.U,
+      "b0001".U -> 2.U,
+      "b0010".U -> 4.U,
+      "b0011".U -> 8.U
+    ))
+    val lowbit = MuxLookup(mode_reg(2,0), 0.U(24.W))(Seq(
+      "b0000".U -> "b0".U(24.W),
+      "b0001".U -> "b1".U(24.W),
+      "b0010".U -> "b11".U(24.W),
+      "b0011".U -> "b111".U(24.W)
+    ))
+    val burst_cnt = Reg(UInt(4.W))
+
+    val readerl = Module(new SDRAMReader)
+    val writerl = Module(new SDRAMWriter)
+    val readerh = Module(new SDRAMReader)
+    val writerh = Module(new SDRAMWriter)
+
+    readerl.io.valid := false.B
+    readerl.io.addr := 0.U
+    readerl.io.high := false.B
+    readerh.io.valid := false.B
+    readerh.io.addr := 0.U
+    readerh.io.high := true.B
+    
+    writerl.io.valid := false.B
+    writerl.io.high := false.B
+    List(writerl.io.addr, writerl.io.data, writerl.io.mask).map(_ := 0.U)
+    writerl.io.clk := io.clk
+    writerh.io.valid := false.B
+    writerh.io.high := true.B
+    List(writerh.io.addr, writerh.io.data, writerh.io.mask).map(_ := 0.U)
+    writerh.io.clk := io.clk
+
+    when(io.cke){
+      
+      when(cmd === "b0011".U){// active a row
+        rows(io.ba) := io.a
+      }
+      when(cmd === "b0000".U){// set mode register
+        mode_reg := io.a
+      }
+      
+      // 写命令处理
+      val WRITE_CMD = (cmd === "b0100".U)
+      val write_bursting = withReset(!io.cke)(RegInit(false.B))
+      val wburst_cnt = Reg(UInt(4.W))
+      val waddr_reg = Reg(UInt(24.W))
+      when(WRITE_CMD) {
+        // 当前周期：立即锁存数据
+        write_bursting := !(burst_length === 1.U)
+        wburst_cnt := 1.U
+        
+        // 地址解析：组合bank、row、column
+        val waddr = Cat(io.ba, rows(io.ba), io.a(8,0))
+        
+        writerl.io.mask := io.dqm(1,0)
+        writerl.io.valid := true.B
+        writerl.io.addr := waddr
+        writerl.io.data := dq_in(15,0)
+        writerh.io.mask := io.dqm(3,2)
+        writerh.io.valid := true.B
+        writerh.io.addr := waddr
+        writerh.io.data := dq_in(31,16)
+        
+        // 更新地址寄存器（自动递增，符合burst模式）
+        waddr_reg := ((waddr + 1.U) & lowbit) | (waddr & ~lowbit)
+      }
+
+      when(write_bursting) {
+        wburst_cnt := wburst_cnt + 1.U
+        
+        writerl.io.mask := io.dqm(1,0)
+        writerl.io.valid := true.B
+        writerl.io.addr := waddr_reg
+        writerl.io.data := dq_in(15,0)
+        writerh.io.mask := io.dqm(3,2)
+        writerh.io.valid := true.B
+        writerh.io.addr := waddr_reg
+        writerh.io.data := dq_in(31,16)
+        
+        // 更新地址寄存器
+        waddr_reg := ((waddr_reg + 1.U) & lowbit) | (waddr_reg & ~lowbit)
+        
+        // 当前要到来的beat是最后的 1 beat
+        when(wburst_cnt + 1.U === burst_length) {
+          write_bursting := false.B
+        }
+      }
+
+
+      val READ_CMD = (cmd === "b0101".U)
+      val read_cmd_reg = withReset(!io.cke)(RegInit(false.B))
+      val read_bursting = withReset(!io.cke)(RegInit(false.B))
+      read_cmd_reg := Mux(READ_CMD, true.B, read_cmd_reg)
+      burst_cnt := Mux(READ_CMD, 1.U, burst_cnt)
+
+      val latency_cnt = Reg(UInt(3.W))
+      latency_cnt := Mux(READ_CMD, 1.U, latency_cnt)
+      addr_reg := Mux(READ_CMD, Cat(io.ba, rows(io.ba), io.a(8,0)), addr_reg)
+
+      when(read_cmd_reg && latency_cnt < cas_latency){
+        latency_cnt := latency_cnt + 1.U
+      }.elsewhen(read_cmd_reg && latency_cnt === cas_latency){// first beat
+        addr_reg := ((addr_reg + 1.U) & lowbit) | (addr_reg & ~lowbit)
+        readerl.io.valid := true.B
+        readerl.io.addr := addr_reg
+        readerh.io.valid := true.B
+        readerh.io.addr := addr_reg
+        dq_out_en := true.B
+        dq_out := Cat(readerh.io.rdata, readerl.io.rdata)
+
+        when(burst_cnt === burst_length){// last beat
+          read_cmd_reg := false.B
+        }.otherwise{
+          burst_cnt := burst_cnt + 1.U
+        }
+      }
+
+      when(cmd === "b0110".U){
+        write_bursting := false.B
+        read_bursting := false.B
+      }
+    }
+
+
+    }
+  }
 }
 
