diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..7e78ca06 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -4,6 +4,121 @@ module psram(
   inout [3:0] dio
 );
 
-  assign dio = 4'bz;
+import "DPI-C" function void psram_read(input int addr, output int data);
+import "DPI-C" function void psram_write(input int addr, input byte data);
+
+  typedef enum [2:0] { cmd_t, addr_t, wait_t, data_t, wdata_t, err_t } state_t;
+
+  wire reset = ce_n;
+  reg [7:0] cmd;
+  reg [4:0] counter;
+  reg [2:0] state;
+  reg [23:0] addr;
+  reg [31:0] data;
+  reg write;
+  wire [31:0]data_ = {data[7:0], data[15:8], data[23:16], data[31:24]};
+  reg qpi_mode;
+
+  wire cmd_done = qpi_mode ? (counter == 5'd1) : (counter == 5'd7);
+  wire [7:0]cmd_ = qpi_mode ? {cmd[3:0], dio} : {cmd[6:0],dio[0]};
+
+  initial begin
+    qpi_mode = 0;
+  end
+
+  always @(posedge sck or posedge reset) begin
+    if(reset) begin
+      state <= cmd_t;
+      counter <= 0;
+      write <= 0;
+    end
+    else begin
+      counter <= counter + 5'd1;
+      case (state)
+        cmd_t : begin
+          if(cmd_done) begin
+            counter <= 0;
+            if(cmd_ == 8'hEB) state <= addr_t;
+            else if(cmd_ == 8'h38) state <= addr_t;
+            else if(cmd_ == 8'h35) qpi_mode <= 1;
+            else state <= err_t;
+          end
+        end
+        addr_t : begin
+          if(counter == 5'd5) begin
+            counter <= 0;
+            if(cmd == 8'hEB) state <= wait_t;
+            else state <= wdata_t;
+          end
+        end
+        wait_t : begin
+          if(counter == 5'd6) begin
+            counter <= 0;
+            state <= data_t;
+          end
+        end
+        data_t : begin
+          if(counter == 5'd7) begin
+            counter <= 0;
+            state <= cmd_t;
+          end
+        end
+        wdata_t : begin
+          if(counter == 5'd1)begin
+            counter <= 0;
+            state <= wdata_t;
+          end
+        end
+        default : begin
+          $display("error\n");
+          $fatal;
+        end
+      endcase
+    end
+  end
+
+  always @(posedge sck or negedge sck) begin
+      case (state)
+        cmd_t : if(sck) begin
+            if(qpi_mode) cmd <=  {cmd[3:0],dio};
+            else cmd <= {cmd[6:0],dio[0]};
+        end
+        addr_t : if(sck) addr <= {addr[19:0],dio};
+        wait_t : if(sck) begin
+          if(counter == 0)begin
+            psram_read({8'd0,addr},data);
+          end
+          else if(counter == 5'd1)begin
+            data <= data_;
+          end
+        end
+        data_t : if(!sck) data <= {data[27:0],4'd0};
+        wdata_t : if(sck) begin
+          data <= {data[27:0], dio};
+          if(counter == 5'd1)begin
+            psram_write({8'd0,addr},{data[3:0], dio});
+            addr <= addr + 1;
+          end
+        end
+        default : ;
+      endcase 
+    end
+
+    // always @(negedge sck) begin
+    //   case (state)
+    //     data_t : data <= {data[27:0],4'd0};
+    //     wdata_t : begin
+    //       data <= {data[27:0], dio};
+    //       if(counter == 5'd1)begin
+    //         psram_write({8'd0,addr},{data[3:0], dio});
+    //         addr <= addr + 1;
+    //       end
+    //     end
+    //     default:;
+    //   endcase
+    // end
+  // end
+
+  assign dio = state == data_t ? data[31:28] : 4'dz;
 
 endmodule
