+
+class XIPFlash extends Module{
+  val SPI_BASE = 0x10001000
+  val SPI_SS = SPI_BASE + 0x18
+  val SPI_Tx1 = SPI_BASE + 4
+  val SPI_DIVIDER = SPI_BASE + 0x14
+  val SPI_CTRL = SPI_BASE + 0x10
+  val SPI_Rx0 = SPI_BASE
+
+
+  val io = IO(new Bundle{
+      val in = Flipped(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
+      val out = new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32))
+  })
+
+  io.in.pready := false.B
+  io.in.prdata := DontCare
+  io.in.pslverr := DontCare
+
+  val addr_reg = Reg(UInt(32.W))
+
+  val addr = WireDefault(0.U(32.W))
+  val wdata = WireDefault(0.U(32.W))
+  val wen = WireDefault(false.B)
+  val valid = WireDefault(false.B)
+
+  val ctrl = Module(new SPIRegController)
+  ctrl.mspi <> io.out
+  ctrl.req.valid := valid
+  ctrl.req.addr := addr
+  ctrl.req.wdata := wdata
+  ctrl.req.wen := wen
+
+  val ready = ctrl.req.ready
+  val rdata = ctrl.req.rdata
+  val ctrl_rdata_reg = Reg(UInt(32.W))
+
+  val s_Tx1 :: s_DIVIDER :: s_SS :: s_CTRL :: s_GO :: s_wait :: s_Rx0 :: Nil = Enum(7)
+  val state = RegInit(s_Tx1)
+
+  when(io.in.psel && io.in.penable){
+    assert(!io.in.pwrite)
+    switch(state){
+      is(s_Tx1){
+        addr := SPI_Tx1.U
+        wdata := (0x03.U << 24) | (io.in.paddr & 0x00FFFFFF.U)
+        wen := true.B
+        valid := true.B
+        when(ready){
+          state := s_DIVIDER
+        }
+      }
+      is(s_DIVIDER){
+          addr := SPI_DIVIDER.U
+          wdata := 1.U
+          wen := true.B
+          valid := true.B
+          when(ready){
+            state := s_SS
+          }
+      }
+      is(s_SS){
+          addr := SPI_SS.U
+          wdata := 1.U
+          wen := true.B
+          valid := true.B
+          when(ready){
+            state := s_CTRL
+          }
+      }
+      is(s_CTRL){
+          addr := SPI_CTRL.U
+          wdata := 0x2000.U | 0x400.U | 0x40.U // ASS_BIT | Tx_NEG_BIT | (64 & CHAR_LEN_BITS)
+          wen := true.B
+          valid := true.B
+          when(ready){
+            state := s_GO
+          }
+      }
+      is(s_GO){
+          addr := SPI_CTRL.U
+          // ASS_BIT | Tx_NEG_BIT | (64 & CHAR_LEN_BITS) | GO_BSY_BIT
+          wdata := 0x2000.U | 0x400.U | 0x40.U | 0x100.U
+          wen := true.B
+          valid := true.B
+          when(ready){
+            state := s_wait
+          }
+      }
+      is(s_wait){
+          addr := SPI_CTRL.U
+          valid := true.B
+          when(ready && !rdata(8)){
+            state := s_Rx0
+          }
+      }
+      is(s_Rx0){
+          addr := SPI_Rx0.U
+          valid := true.B
+          when(ready){
+            state := s_Tx1
+            io.in.pready := true.B
+            io.in.prdata := Cat(rdata(7,0),rdata(15,8),rdata(23,16),rdata(31,24))
+          }
+      }
+    }
+  }
+
+}
+
+class SPIRegController extends Module{
+  val req = IO(new Bundle{
+    val addr = Input(UInt(32.W))
+    val wdata = Input(UInt(32.W))
+    val wen = Input(Bool())
+    val rdata = Output(UInt(32.W))
+    val valid = Input(Bool())
+    val ready = Output(Bool())
+  })
+  val mspi = IO(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
+  val s_idle :: s_busy :: Nil = Enum(2)
+  val state = RegInit(s_idle)
+
+  mspi.psel := false.B
+  mspi.penable := false.B
+  mspi.paddr := req.addr //这个地方报错
+  mspi.pwrite := req.wen
+  mspi.pwdata := req.wdata
+  mspi.pstrb := 0xF.U
+  mspi.pprot := 0.U
+  
+  req.ready := mspi.pready
+  req.rdata := mspi.prdata
+
+  state := s_idle
+  when(req.valid){
+    mspi.psel := true.B
+    switch(state){
+      is(s_idle){
+        state := s_busy
+      }
+      is(s_busy){
+        mspi.penable := true.B
+        when(mspi.pready){
+          assert(mspi.pslverr =/= 0.U)
+          state := s_idle
+        }
+      }
+    }
+
   }
 }
