   val io = IO(Flipped(new SDRAMIO))
 }
 
+class SDRAMReader extends BlackBox with HasBlackBoxInline {
+  val io = IO(new Bundle{
+    val high_sdram = Input(Bool())
+    val addr = Input(UInt(24.W))
+    val valid = Input(Bool())
+    val rdata = Output(UInt(32.W))
+  })
+  setInline("SDRAMReader.v",
+    """module SDRAMReader(
+      |  input high_sdram,
+      |  input [23:0] addr,
+      |  input valid,
+      |  output reg [31:0] rdata
+      |);
+      |import "DPI-C" function void sdram_read(input byte high_sdram, input int addr, output int rdata);
+      |always @(*) begin
+      |  if (valid) sdram_read({7'd0, high_sdram}, {8'd0, addr}, rdata);
+      |  else rdata = 0;
+      |end
+      |endmodule
+    """.stripMargin)
+}
+
+class SDRAMWriter extends BlackBox with HasBlackBoxInline {
+  val io = IO(new Bundle{
+    val high_sdram = Input(Bool())
+    val clk = Input(Bool())
+    val addr = Input(UInt(24.W))
+    val data = Input(UInt(32.W))
+    val mask = Input(UInt(4.W))
+    val valid = Input(Bool())
+  })
+  setInline("SDRAMWriter.v",
+    """module SDRAMWriter(
+      |  input high_sdram,
+      |  input clk,
+      |  input [23:0] addr,
+      |  input [31:0] data,
+      |  input [3:0] mask,
+      |  input valid
+      |);
+      |import "DPI-C" function void sdram_write(input byte high_sdram, input int addr, input int wdata, input byte mask);
+      |always @(posedge clk) begin
+      |  if (valid) sdram_write({7'd0, high_sdram}, {8'd0, addr}, data, {4'd0, mask});
+      |end
+      |endmodule
+    """.stripMargin)
+}
+
 class sdramChisel extends RawModule {
   val io = IO(Flipped(new SDRAMIO))
+  val dq_out_en = WireDefault(false.B)
+  val dq_out = Wire(UInt(32.W))
+  dq_out := DontCare
+  val dq_in = TriStateInBuf(io.dq, dq_out, dq_out_en)
+  
+  withClock(io.clk.asClock){
+    when(io.cke){
+    val cs = WireDefault(true.B)
+    
+    val mode_reg = Reg(UInt(13.W))
+    val rows = Reg(Vec(4,UInt(13.W)))
+    val addr_reg = Reg(UInt(24.W))
+    val cas_latency = mode_reg(6,4)
+
+    val reader = Module(new SDRAMReader)
+    val writer = Module(new SDRAMWriter)
+    reader.io.high_sdram := !io.cs(1)
+    writer.io.high_sdram := !io.cs(1)
+    cs := (~io.cs(0)) || (~io.cs(1))
+    val cmd = Cat(~cs, io.ras, io.cas, io.we)
+
+    reader.io.valid := false.B
+    reader.io.addr := 0.U
+
+    writer.io.valid := false.B
+    List(writer.io.addr, writer.io.data, writer.io.mask).map(_ := 0.U)
+    writer.io.clk := io.clk
+
+    when(io.cke){
+      
+      when(cmd === "b0011".U){// active a row
+        rows(io.ba) := io.a
+      }
+      when(cmd === "b0000".U){// set mode register
+        mode_reg := io.a
+      }
+      
+      when(cmd === "b0100".U) { // write
+        val waddr = Cat(rows(io.ba), io.ba, io.a(8,0))
+        writer.io.mask := io.dqm
+        writer.io.valid := true.B
+        writer.io.addr := waddr
+        writer.io.data := dq_in
+      }
+
+      val read_cmd_reg = withReset(!io.cke)(RegInit(false.B))
+      val latency_cnt = Reg(UInt(3.W))
+
+      when(cmd === "b0101".U){ //read
+        read_cmd_reg := true.B
+        latency_cnt := 1.U
+        addr_reg := Cat(rows(io.ba), io.ba, io.a(8,0))
+      }.otherwise{
+        when(read_cmd_reg && latency_cnt < cas_latency){
+          latency_cnt := latency_cnt + 1.U
+        }.elsewhen(read_cmd_reg && latency_cnt === cas_latency){
+          reader.io.valid := true.B
+          reader.io.addr := addr_reg
+          dq_out_en := true.B
+          dq_out := reader.io.rdata
+          read_cmd_reg := false.B
+        }
+      }
+
+    }
+
+
+    }
+  }
 }
 
