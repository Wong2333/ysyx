 class APBDelayerChisel extends Module {
   val io = IO(new APBDelayerIO)
-  io.out <> io.in
+  val r = 8
+
+  val sIdle :: sWait :: sSend :: Nil = Enum(3)
+  val state   = RegInit(sIdle)
+  val t       = RegInit(0.U(32.W))
+  val due     = RegInit(0.U(32.W))
+  val prdata  = RegInit(0.U(32.W))
+  val pslverr = RegInit(false.B)
+
+  io.out.paddr   := io.in.paddr
+  io.out.pprot   := io.in.pprot
+  io.out.pwrite  := io.in.pwrite
+  io.out.pwdata  := io.in.pwdata
+  io.out.pstrb   := io.in.pstrb
+  io.out.psel    := (state =/= sSend) && io.in.psel
+  io.out.penable := (state =/= sSend) && io.in.penable
+
+  switch(state) {
+    is(sIdle) {
+      when(io.in.psel) {
+        t     := 0.U
+        state := sWait
+      }
+    }
+    is(sWait) {
+      when(io.out.pready) {
+        due     := t * r.U
+        prdata  := io.out.prdata
+        pslverr := io.out.pslverr
+        state   := sSend
+      }.elsewhen(io.in.psel) {
+        t := t + 1.U
+      }.otherwise {
+        state := sIdle
+      }
+    }
+    is(sSend) {
+      when(t >= due) { state := sIdle }
+      .otherwise     { t := t + 1.U }
+    }
+  }
+
+  io.in.pready  := (state === sSend) && (t >= due)
+  io.in.prdata  := prdata
+  io.in.pslverr := pslverr
 }
 
