---
 perip/sdram/core_sdram_axi4/sdram_axi.v      |  8 ++--
 perip/sdram/core_sdram_axi4/sdram_axi_core.v | 43 +++++++++++++++----
 perip/sdram/sdram_top_axi.v                  | 10 ++---
 src/Top.scala                                |  2 +-
 src/amba/APBDelayer.scala                    |  2 +-
 src/device/SDRAM.scala                       | 44 +++++++++++---------
 6 files changed, 71 insertions(+), 38 deletions(-)

diff --git a/perip/sdram/core_sdram_axi4/sdram_axi.v b/perip/sdram/core_sdram_axi4/sdram_axi.v
index 64641f58..2e369942 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi.v
@@ -53,7 +53,7 @@ module sdram_axi
     ,input  [  7:0]  inport_arlen_i
     ,input  [  1:0]  inport_arburst_i
     ,input           inport_rready_i
-    ,input  [ 15:0]  sdram_data_input_i
+    ,input  [ 31:0]  sdram_data_input_i
 
     // Outputs
     ,output          inport_awready_o
@@ -69,14 +69,14 @@ module sdram_axi
     ,output          inport_rlast_o
     ,output          sdram_clk_o
     ,output          sdram_cke_o
-    ,output          sdram_cs_o
+    ,output [1:0]    sdram_cs_o
     ,output          sdram_ras_o
     ,output          sdram_cas_o
     ,output          sdram_we_o
-    ,output [  1:0]  sdram_dqm_o
+    ,output [  3:0]  sdram_dqm_o
     ,output [ 12:0]  sdram_addr_o
     ,output [  1:0]  sdram_ba_o
-    ,output [ 15:0]  sdram_data_output_o
+    ,output [ 31:0]  sdram_data_output_o
     ,output          sdram_data_out_en_o
 );
 
diff --git a/perip/sdram/core_sdram_axi4/sdram_axi_core.v b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
index 5acdb887..b05e04c2 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi_core.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
@@ -105,7 +105,7 @@ localparam STATE_ACTIVATE    = 4'd3;
 localparam STATE_READ        = 4'd4;
 localparam STATE_READ_WAIT   = 4'd5;
 localparam STATE_WRITE       = 4'd6;
-//localparam STATE_WRITE1      = 4'd7;
+localparam STATE_WRITE_DECIDE = 4'd7; // 写完成后的判定拍（检查下一 beat 是否就绪）
 localparam STATE_PRECHARGE   = 4'd8;
 localparam STATE_REFRESH     = 4'd9;
 
@@ -177,7 +177,16 @@ reg  [STATE_W-1:0]     target_state_q;
 reg  [STATE_W-1:0]     delay_state_q;
 
 // Address bits
-assign sdram_cs_o = {~ram_addr_w[SDRAM_ADDR_W + 1], ram_addr_w[SDRAM_ADDR_W + 1]};
+// 片选选择位：请求接受拍（READ/WRITE 状态）锁存地址 bit25。
+// 若组合跟随 ram_addr_w，写握手完成后 addr_w 会切换为 araddr，
+// 导致写命令显示拍（颗粒模型采样拍）的 cs/high_sdram 错误。
+reg cs_sel_q;
+always @ (posedge clk_i or posedge rst_i)
+if (rst_i)
+    cs_sel_q <= 1'b0;
+else if (ram_accept_w)
+    cs_sel_q <= ram_addr_w[SDRAM_ADDR_W + 1];
+assign sdram_cs_o = {~cs_sel_q, cs_sel_q};
 wire [SDRAM_ROW_W-1:0]  addr_col_w  = {{(SDRAM_ROW_W-SDRAM_COL_W){1'b0}}, ram_addr_w[SDRAM_COL_W+1:2]};
 wire [SDRAM_ROW_W-1:0]  addr_row_w  = ram_addr_w[SDRAM_ADDR_W+1:SDRAM_COL_W+4];
 wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[SDRAM_COL_W+3:SDRAM_COL_W+2];
@@ -284,10 +293,21 @@ begin
     // STATE_WRITE
     //-----------------------------------------
     STATE_WRITE :
+    begin
+        // 32 位单拍写完当前 beat，进入判定拍：
+        // 写进行拍时 ram_wr_w 是当前 beat 的数据，必须等握手完成后
+        // （判定拍）ram_wr_w 才真正反映下一 beat 是否就绪，避免误判 burst
+        next_state_r = STATE_WRITE_DECIDE;
+    end
+    //-----------------------------------------
+    // STATE_WRITE_DECIDE
+    //-----------------------------------------
+    STATE_WRITE_DECIDE :
     begin
         next_state_r = STATE_IDLE; // Default: go back to IDLE
-        
-        if (!refresh_q && ram_req_w && (ram_wr_w != 4'b0))
+
+        // 写握手已完成，ram_wr_w != 0 表示 burst 的下一 beat 数据已就绪
+        if (!refresh_q && (ram_wr_w != 4'b0))
         begin
             if (row_open_q[addr_bank_w] && addr_row_w == active_row_q[addr_bank_w])
                 next_state_r = STATE_WRITE; // Stay in WRITE for burst
@@ -602,15 +622,24 @@ begin
         command_q       <= CMD_WRITE;
         addr_q          <= addr_col_w;
         bank_q          <= addr_bank_w;
-        
-        data_q          <= ram_write_data_w; 
+
+        data_q          <= ram_write_data_w;
 
         addr_q[AUTO_PRECHARGE]  <= 1'b0;
 
-        dqm_q           <= ~ram_wr_w; 
+        dqm_q           <= ~ram_wr_w;
 
         data_rd_en_q    <= 1'b0;
     end
+    //-----------------------------------------
+    // STATE_WRITE_DECIDE
+    //-----------------------------------------
+    STATE_WRITE_DECIDE :
+    begin
+        // 判定拍不发命令、释放 dq 总线（避免颗粒模型收到第二个 WRITE 命令）
+        command_q       <= CMD_NOP;
+        data_rd_en_q    <= 1'b1;
+    end
     endcase
 end
 
diff --git a/perip/sdram/sdram_top_axi.v b/perip/sdram/sdram_top_axi.v
index f0fd6fdb..3e216bbd 100644
--- a/perip/sdram/sdram_top_axi.v
+++ b/perip/sdram/sdram_top_axi.v
@@ -33,19 +33,19 @@ module sdram_top_axi(
 
   output        sdram_clk,
   output        sdram_cke,
-  output        sdram_cs,
+  output [1:0]  sdram_cs,
   output        sdram_ras,
   output        sdram_cas,
   output        sdram_we,
   output [12:0] sdram_a,
   output [ 1:0] sdram_ba,
-  output [ 1:0] sdram_dqm,
-  inout  [15:0] sdram_dq
+  output [ 3:0] sdram_dqm,
+  inout  [31:0] sdram_dq
 );
 
   wire sdram_dout_en;
-  wire [15:0] sdram_dout;
-  assign sdram_dq = sdram_dout_en ? sdram_dout : 16'bz;
+  wire [31:0] sdram_dout;
+  assign sdram_dq = sdram_dout_en ? sdram_dout : 32'bz;
   sdram_axi #(
     .SDRAM_MHZ(100),
     .SDRAM_ADDR_W(24),
diff --git a/src/Top.scala b/src/Top.scala
index c00378a6..2913155b 100644
--- a/src/Top.scala
+++ b/src/Top.scala
@@ -7,7 +7,7 @@ import freechips.rocketchip.diplomacy.LazyModule
 
 object Config {
   def hasChipLink: Boolean = false
-  def sdramUseAXI: Boolean = false
+  def sdramUseAXI: Boolean = true
 }
 
 class ysyxSoCTop extends Module {
diff --git a/src/amba/APBDelayer.scala b/src/amba/APBDelayer.scala
index 2a5014b2..96de08fb 100644
--- a/src/amba/APBDelayer.scala
+++ b/src/amba/APBDelayer.scala
@@ -26,7 +26,7 @@ class APBDelayerChisel extends Module {
   // r = f_cpu / f_device, device is assumed to run at 100MHz.
   // Default CPU frequency is 550MHz -> r = 5.5; update r with the
   // yosys-sta frequency report when available.
-  val r = 5.5
+  val r = 8
   // s: power-of-2 scale factor; truncation error is reduced to 1/s
   val log2s = 5
   val s = (1 << log2s)
diff --git a/src/device/SDRAM.scala b/src/device/SDRAM.scala
index 8383f253..f059e827 100644
--- a/src/device/SDRAM.scala
+++ b/src/device/SDRAM.scala
@@ -216,28 +216,32 @@ class sdramChisel extends RawModule {
       val READ_CMD = (cmd === "b0101".U)
       val read_cmd_reg = withReset(!io.cke)(RegInit(false.B))
       val read_bursting = withReset(!io.cke)(RegInit(false.B))
-      read_cmd_reg := Mux(READ_CMD, true.B, read_cmd_reg)
-      burst_cnt := Mux(READ_CMD, 1.U, burst_cnt)
-
       val latency_cnt = Reg(UInt(3.W))
-      latency_cnt := Mux(READ_CMD, 1.U, latency_cnt)
-      addr_reg := Mux(READ_CMD, Cat(rows(io.ba), io.ba, io.a(8,0)), addr_reg)
-
-      when(read_cmd_reg && latency_cnt < cas_latency){
-        latency_cnt := latency_cnt + 1.U
-      }.elsewhen(read_cmd_reg && latency_cnt === cas_latency){// first beat
-        addr_reg := ((addr_reg + 1.U) & lowbit) | (addr_reg & ~lowbit)
-        readerl.io.valid := true.B
-        readerl.io.addr := addr_reg
-        readerh.io.valid := true.B
-        readerh.io.addr := addr_reg
-        dq_out_en := true.B
-        dq_out := Cat(readerh.io.rdata, readerl.io.rdata)
+      // READ_CMD 必须拥有最高优先级：控制器逐 beat 发命令时，新命令的
+      // 到达拍恰好是上一条命令的输出拍（latency===CL），若清零（内层
+      // when）优先于置位（外层 Mux），背靠背命令会被吞掉
+      when(READ_CMD){
+        read_cmd_reg := true.B
+        burst_cnt := 1.U
+        latency_cnt := 1.U
+        addr_reg := Cat(rows(io.ba), io.ba, io.a(8,0))
+      }.otherwise{
+        when(read_cmd_reg && latency_cnt < cas_latency){
+          latency_cnt := latency_cnt + 1.U
+        }.elsewhen(read_cmd_reg && latency_cnt === cas_latency){// first beat
+          addr_reg := ((addr_reg + 1.U) & lowbit) | (addr_reg & ~lowbit)
+          readerl.io.valid := true.B
+          readerl.io.addr := addr_reg
+          readerh.io.valid := true.B
+          readerh.io.addr := addr_reg
+          dq_out_en := true.B
+          dq_out := Cat(readerh.io.rdata, readerl.io.rdata)
 
-        when(burst_cnt === burst_length){// last beat
-          read_cmd_reg := false.B
-        }.otherwise{
-          burst_cnt := burst_cnt + 1.U
+          when(burst_cnt === burst_length){// last beat
+            read_cmd_reg := false.B
+          }.otherwise{
+            burst_cnt := burst_cnt + 1.U
+          }
         }
       }
 
