diff --git a/src/device/SPI.scala b/src/device/SPI.scala
index c354bb92..ecbfe1a7 100644
--- a/src/device/SPI.scala
+++ b/src/device/SPI.scala
@@ -43,10 +43,129 @@ class APBSPI(address: Seq[AddressSet])(implicit p: Parameters) extends LazyModul
     val (in, _) = node.in(0)
     val spi_bundle = IO(new SPIIO)
 
+    val mspi_xip = Module(new spi_top_apb)
     val mspi = Module(new spi_top_apb)
+    val XIP_Flash = Module(new XIPFlash)
+    mspi_xip.io.clock := clock
+    mspi_xip.io.reset := reset
+    mspi_xip.io.in <> DontCare
+    mspi_xip.io.spi <> DontCare
+    mspi_xip.io.in.psel := false.B
+    mspi_xip.io.in.penable := false.B
+
     mspi.io.clock := clock
     mspi.io.reset := reset
+    mspi.io.in <> DontCare
+    mspi.io.spi <> DontCare
+    mspi.io.in.psel := false.B
+    mspi.io.in.penable := false.B
+
+    XIP_Flash.io <> DontCare
+    XIP_Flash.io.in.psel := false.B
+    XIP_Flash.io.in.penable := false.B
+
     mspi.io.in <> in
     spi_bundle <> mspi.io.spi
+
+    when(in.paddr >=0x30000000.U && in.paddr <0x40000000.U){
+      when(in.psel){
+        XIP_Flash.io.in <> in
+        mspi_xip.io.in <> XIP_Flash.io.out
+        spi_bundle <> mspi_xip.io.spi
+      }
+    }
+
+  }
+}
+
+class XIPFlash extends Module{
+  // 基址 0x1000_1000
+  val SPI_Rx0     = 0x10001000
+  val SPI_Tx1     = 0x10001004
+  val SPI_CTRL    = 0x10001010
+  val SPI_DIVIDER = 0x10001014
+  val SPI_SS      = 0x10001018
+
+  // CTRL：ASS(13) | Tx_NEG(10) | CHAR_LEN(6:0)=0x40；| GO(8) 开始传输
+  val CTRL_BASE = 0x2000 | 0x400 | 0x40
+  val CTRL_GO   = CTRL_BASE | 0x100
+
+  val io = IO(new Bundle{
+      val in  = Flipped(new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32)))
+      val out = new APBBundle(APBBundleParameters(addrBits = 32, dataBits = 32))
+  })
+
+  io.in.pready  := false.B
+  io.in.prdata  := DontCare
+  io.in.pslverr := false.B
+
+  val micro_addr = VecInit(Seq(
+    SPI_Tx1.U(32.W), SPI_DIVIDER.U(32.W), SPI_SS.U(32.W),
+    SPI_CTRL.U(32.W), SPI_CTRL.U(32.W)))
+  val micro_data = VecInit(Seq(
+    (0x03.U << 24) | (io.in.paddr & 0x00FFFFFF.U),   // 0x03 = flash READ + 24 位地址
+    1.U(32.W),                                       // DIVIDER
+    1.U(32.W),                                       // SS
+    CTRL_BASE.U(32.W),                               // ASS | Tx_NEG | CHAR_LEN
+    CTRL_GO.U(32.W)))                                // 同上 | GO
+
+  val s_WRITE :: s_POLL :: s_READ :: Nil = Enum(3)
+  val state = RegInit(s_WRITE)
+  val idx   = RegInit(0.U(3.W))
+  val phase = RegInit(false.B)
+
+  io.out.psel    := false.B
+  io.out.penable := false.B
+  io.out.paddr   := 0.U
+  io.out.pwdata  := 0.U
+  io.out.pwrite  := false.B
+  io.out.pstrb   := 0xF.U
+  io.out.pprot   := 0.U
+
+  when(io.in.psel && io.in.penable){
+    assert(!io.in.pwrite)
+    switch(state){
+      is(s_WRITE){
+        io.out.psel    := true.B
+        io.out.paddr   := micro_addr(idx)
+        io.out.pwdata  := micro_data(idx)
+        io.out.pwrite  := true.B
+        io.out.penable := phase
+        when(io.out.pready){
+          phase := false.B
+          when(idx === 4.U){ state := s_POLL }.otherwise{ idx := idx + 1.U }
+        }.otherwise{
+          phase := true.B
+        }
+      }
+      is(s_POLL){
+        io.out.psel    := true.B
+        io.out.paddr   := SPI_CTRL.U
+        io.out.pwrite  := false.B
+        io.out.penable := phase
+        when(io.out.pready){
+          phase := false.B
+          when(!io.out.prdata(8)){ state := s_READ } // GO 位清零才表示传完
+        }.otherwise{
+          phase := true.B
+        }
+      }
+      is(s_READ){
+        io.out.psel    := true.B
+        io.out.paddr   := SPI_Rx0.U
+        io.out.pwrite  := false.B
+        io.out.penable := phase
+        when(io.out.pready){
+          phase := false.B
+          idx   := 0.U
+          state := s_WRITE
+          io.in.pready := true.B
+          io.in.prdata := Cat(io.out.prdata(7,0),  io.out.prdata(15,8),
+                              io.out.prdata(23,16), io.out.prdata(31,24))
+        }.otherwise{
+          phase := true.B
+        }
+      }
+    }
   }
 }
