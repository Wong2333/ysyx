index b6e737e9..1907724e 100644
--- a/perip/psram/efabless/EF_PSRAM_CTRL.v
+++ b/perip/psram/efabless/EF_PSRAM_CTRL.v
@@ -234,3 +234,74 @@ module PSRAM_WRITER (
 
 
 endmodule
+
+
+module PSRAM_QPI_INIT (
+    input   wire            clk,
+    input   wire            rst_n,
+    output  wire            done,
+
+    output  reg             sck,
+    output  reg             ce_n,
+    input   wire [3:0]      din,
+    output  wire [3:0]      dout,
+    output  wire            douten
+);
+    //localparam  DATA_START = 14;
+    localparam  INIT = 1'b0,
+                DONE = 1'b1;
+
+
+    reg         state;
+    reg [2:0]   counter;
+
+    wire[7:0]   CMD_35H = 8'h35;
+
+    always @(posedge clk or negedge rst_n)
+        if(!rst_n) state <= INIT;
+        else begin
+            case (state)
+                INIT: begin
+                    if(counter == 3'd7) state <= DONE;
+                    else state <= INIT;
+                end
+                DONE: begin
+                    state <= DONE;
+                end
+            endcase
+        end
+
+
+    // Drive the Serial Clock (sck) @ clk/2
+    always @ (posedge clk or negedge rst_n)
+        if(!rst_n)
+            sck <= 1'b0;
+        else if(~ce_n)
+            sck <= ~ sck;
+        else if(state == DONE)
+            sck <= 1'b0;
+
+    // ce_n logic
+    always @ (posedge clk or negedge rst_n)
+        if(!rst_n)
+            ce_n <= 1'b1;
+        else if(state == INIT)
+            ce_n <= 1'b0;
+        else
+            ce_n <= 1'b1;
+
+    always @ (posedge clk or negedge rst_n)
+        if(!rst_n)
+            counter <= 3'b0;
+        else if(sck)
+            counter <= counter + 1;
+
+
+    assign dout = {3'b0, CMD_35H[7 - counter]};
+
+    assign douten   = (~ce_n);
+
+    assign done     = state == DONE;
+
+
+endmodule
