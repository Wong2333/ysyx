CONFIG__ENABLE_C=y
CONFIG__ENABLE_VERILOG=y

#
# Debug and difftest setting
#
CONFIG_ENABLE_SDB=y
CONFIG_ENABLE_DIFFTEST=y
CONFIG_ENABLE_ITRACE=y
CONFIG_ENABLE_MTRACE=y
CONFIG_ENABLE_FTRACE=y
CONFIG_ENABLE_FST_TRACE=y
CONFIG_TRACE_PATH="./"
# end of Debug and difftest setting

